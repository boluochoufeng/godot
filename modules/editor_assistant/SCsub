#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_assistant = env_modules.Clone()
module_obj = []

if env.editor_build:
    env_assistant.add_source_files(module_obj, "*.cpp")
    env_assistant.add_source_files(module_obj, "mcp/*.cpp")
    env_assistant.add_source_files(module_obj, "mcp/tools/*.cpp")
    if env["tests"]:
        env_assistant.add_source_files(module_obj, "tests/*.cpp")

env.modules_sources += module_obj
